# Where the RamChems API is served. Defaults to http://localhost:8434.
#
# 8434 rather than 8000 on purpose: 8000 is every framework's default, so on a
# machine running several projects it is contended - and a server answering
# there may belong to a different project entirely. Change this if you run the
# API somewhere else; do not hardcode a URL in the source.
VITE_API_BASE=http://localhost:8434
